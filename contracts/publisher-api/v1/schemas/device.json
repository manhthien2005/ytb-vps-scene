{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemas": {
    "PublisherCapabilities": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "apiMajor": {
          "const": 1,
          "type": "number"
        },
        "apiMinor": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "automationPolicy": {
          "enum": [
            "STANDARD_ASSIST",
            "MANUAL_ONLY",
            "DISABLED"
          ],
          "type": "string"
        },
        "contractSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "features": {
          "additionalProperties": false,
          "properties": {
            "directDriveDownload": {
              "type": "boolean"
            },
            "studioAssist": {
              "type": "boolean"
            },
            "thumbnailApi": {
              "type": "boolean"
            }
          },
          "required": [
            "directDriveDownload",
            "thumbnailApi",
            "studioAssist"
          ],
          "type": "object"
        },
        "latestClientVersion": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "minimumClientVersion": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "apiMajor",
        "apiMinor",
        "contractSha256",
        "minimumClientVersion",
        "latestClientVersion",
        "automationPolicy",
        "features"
      ],
      "type": "object"
    },
    "PublisherEnrollRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "activationToken": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "appVersion": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "deviceLabel": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "activationToken",
        "deviceLabel",
        "appVersion"
      ],
      "type": "object"
    },
    "PublisherEnrollResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "deviceSecret": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "enrolledAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "type": "string"
        }
      },
      "required": [
        "deviceId",
        "deviceSecret",
        "enrolledAt"
      ],
      "type": "object"
    },
    "PublisherHeartbeatRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "activeTaskId": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "appVersion": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "appVersion",
        "activeTaskId"
      ],
      "type": "object"
    }
  }
}
