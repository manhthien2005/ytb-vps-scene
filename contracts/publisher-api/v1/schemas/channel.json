                "maximum": 7,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "weekday",
              "time"
            ],
            "type": "object"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "timezone": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "preferredSlots",
        "minimumGapMinutes",
        "maximumPerDay",
        "minimumLeadMinutes",
        "blackouts"
