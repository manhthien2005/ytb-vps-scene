          "maxItems": 100,
          "type": "array"
        },
        "maximumPerDay": {
          "maximum": 24,
          "minimum": 1,
          "type": "integer"
        },
        "minimumGapMinutes": {
          "maximum": 44640,
          "minimum": 0,
          "type": "integer"
        },
        "minimumLeadMinutes": {
