[Unit]
Description=Standalone resumable YTB video queue
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/ytb-vps
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=CODEX_HOME=/root/.config/ytb-vps/secrets/codex
ExecStart=/opt/ytb-vps/.venv/bin/ytb-vps --config /etc/ytb-vps/config.yaml worker
Restart=on-failure
RestartSec=20
TimeoutStopSec=60
KillSignal=SIGINT
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

