[Unit]
Description=YTB VPS native control worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ytb-vps
Group=ytb-vps
WorkingDirectory=/var/lib/ytb-vps
ExecStart=/opt/ytb-vps/current/.venv/bin/python -m ytb_vps_v2 worker-run --credential-path /var/lib/ytb-vps/worker-credential.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ytb-vps
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
